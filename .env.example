# ================================================
# SPRING BOOT BACKEND ENVIRONMENT VARIABLES
# Add these in Render / Railway / Cloud Provider
# ================================================

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host.com:5432/bonafide_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Application Security (256-bit Hex Key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250655368566D5971

# Public Verification Base URL
VERIFICATION_BASE_URL=https://your-frontend-app.vercel.app/verify?certNo=

# Port (Render/Railway sets PORT automatically)
PORT=8080
